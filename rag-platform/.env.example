# Copy this file to .env and fill in your own key.
# Get a key from https://console.anthropic.com/settings/keys
# Never commit the real .env file -- it's already in .gitignore.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown)
# ANSWER_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-sonnet-5
# EVAL_GEN_MODEL=claude-sonnet-5
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_TOKENS=450
# CHUNK_OVERLAP=75
# TOP_K=5

# Leave empty to use the embedded store in data/qdrant (one process at a time).
# Set to http://localhost:6333 after `docker compose up -d` to run the API and evals side by side.
# QDRANT_URL=

# Wikipedia asks for contact info in the User-Agent (a URL or email of your choosing).
# WIKIPEDIA_CONTACT=https://github.com/<you>/rag-platform

# Signs the demo JWTs for the multi-tenant API (Project 2). Any random string of 32+ characters, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
